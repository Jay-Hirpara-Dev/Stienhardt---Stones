<section class="today-section" data-section-id="{{ section.id }}">
  {% schema %}
    {
      "name": "Today at Stienhardt",
      "settings": [
        {
          "type": "text",
          "id": "hero_heading",
          "label": "Hero Heading",
          "default": "Today at Stienhardt"
        },
        {
          "type": "text",
          "id": "hero_subheading",
          "label": "Hero Subheading",
          "default": "Curated diamonds, handpicked daily by our master gemologists."
        },
        {
          "type": "text",
          "id": "featured_shape",
          "label": "Featured Diamond Shape",
          "default": "Round"
        },
        {
          "type": "textarea",
          "id": "featured_description",
          "label": "Featured Diamond Description",
          "default": "The round brilliant cut remains the world's most popular diamond shape, renowned for its unmatched fire and scintillation. Each facet is mathematically calibrated for maximum light return."
        },
        {
          "type": "text",
          "id": "featured_spec_carat",
          "label": "Featured Carat",
          "default": "2.15 ct"
        },
        {
          "type": "text",
          "id": "featured_spec_clarity",
          "label": "Featured Clarity",
          "default": "VVS1"
        },
        {
          "type": "text",
          "id": "featured_spec_color",
          "label": "Featured Color Grade",
          "default": "D"
        },
        {
          "type": "text",
          "id": "featured_spec_cut",
          "label": "Featured Cut Grade",
          "default": "Ideal"
        },
        {
          "type": "text",
          "id": "featured_price",
          "label": "Featured Price",
          "default": "$38,500"
        },
        {
          "type": "text",
          "id": "deal_title",
          "label": "Daily Deal Title",
          "default": "Today's Exclusive"
        },
        {
          "type": "text",
          "id": "deal_discount",
          "label": "Deal Discount Percentage",
          "default": "15"
        },
        {
          "type": "text",
          "id": "deal_shape",
          "label": "Deal Diamond Shape",
          "default": "Emerald"
        },
        {
          "type": "text",
          "id": "deal_original_price",
          "label": "Deal Original Price",
          "default": "$24,000"
        },
        {
          "type": "text",
          "id": "deal_sale_price",
          "label": "Deal Sale Price",
          "default": "$20,400"
        },
        {
          "type": "text",
          "id": "expert_name",
          "label": "Expert Name",
          "default": "Alexandra Stienhardt"
        },
        {
          "type": "text",
          "id": "expert_title",
          "label": "Expert Title",
          "default": "Head Gemologist, GIA Graduate"
        },
        {
          "type": "textarea",
          "id": "expert_quote",
          "label": "Expert Quote",
          "default": "The cushion cut is experiencing a remarkable renaissance this season. Its soft, romantic silhouette pairs beautifully with both vintage and contemporary settings — a truly versatile choice for the discerning collector."
        },
        {
          "type": "text",
          "id": "expert_pick_shape",
          "label": "Expert Pick Shape",
          "default": "Cushion"
        }
      ],
      "presets": [{
        "name": "Today at Stienhardt",
        "category": "Custom"
      }]
    }
  {% endschema %}

  <!-- ========== HERO SECTION ========== -->
  <div class="today-hero">
    <div class="today-hero__overlay"></div>
    <div class="today-hero__content">
      <span class="today-hero__date" id="today-date"></span>
      <h1 class="today-hero__heading">{{ section.settings.hero_heading }}</h1>
      <p class="today-hero__subheading">{{ section.settings.hero_subheading }}</p>
      <div class="today-hero__scroll-hint">
        <span>Explore Today</span>
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M10 3v14m0 0l-5-5m5 5l5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
    </div>
  </div>

  <!-- ========== FEATURED DIAMOND ========== -->
  <div class="today-featured" id="today-featured">
    <div class="today-featured__badge">Featured Stone</div>
    <div class="today-featured__grid">
      <div class="today-featured__visual">
        <div class="today-featured__img-wrap">
          <img
            src="{{ 'diamond-' | append: section.settings.featured_shape | downcase | append: '.png' | asset_url }}"
            alt="{{ section.settings.featured_shape }} Diamond"
            class="today-featured__img"
          >
          <div class="today-featured__glow"></div>
        </div>
      </div>
      <div class="today-featured__details">
        <span class="today-featured__label">Today's Highlight</span>
        <h2 class="today-featured__title">The {{ section.settings.featured_shape }} Brilliant</h2>
        <p class="today-featured__desc">{{ section.settings.featured_description }}</p>
        <div class="today-featured__specs">
          <div class="today-featured__spec">
            <span class="today-featured__spec-value">{{ section.settings.featured_spec_carat }}</span>
            <span class="today-featured__spec-label">Carat</span>
          </div>
          <div class="today-featured__spec">
            <span class="today-featured__spec-value">{{ section.settings.featured_spec_clarity }}</span>
            <span class="today-featured__spec-label">Clarity</span>
          </div>
          <div class="today-featured__spec">
            <span class="today-featured__spec-value">{{ section.settings.featured_spec_color }}</span>
            <span class="today-featured__spec-label">Color</span>
          </div>
          <div class="today-featured__spec">
            <span class="today-featured__spec-value">{{ section.settings.featured_spec_cut }}</span>
            <span class="today-featured__spec-label">Cut</span>
          </div>
        </div>
        <div class="today-featured__price">{{ section.settings.featured_price }}</div>
        <button class="today-btn today-btn--primary">View This Stone</button>
      </div>
    </div>
  </div>

  <!-- ========== DAILY DEAL COUNTDOWN ========== -->
  <div class="today-deal">
    <div class="today-deal__inner">
      <div class="today-deal__left">
        <div class="today-deal__img-wrap">
          <img
            src="{{ 'diamond-' | append: section.settings.deal_shape | downcase | append: '.png' | asset_url }}"
            alt="{{ section.settings.deal_shape }} Diamond Deal"
            class="today-deal__img"
          >
        </div>
      </div>
      <div class="today-deal__right">
        <span class="today-deal__badge">{{ section.settings.deal_discount }}% Off Today Only</span>
        <h2 class="today-deal__title">{{ section.settings.deal_title }}</h2>
        <p class="today-deal__subtitle">{{ section.settings.deal_shape }} Cut &mdash; Limited Time Offer</p>
        <div class="today-deal__countdown" id="today-countdown">
          <div class="today-deal__countdown-item">
            <span class="today-deal__countdown-num" id="countdown-hours">00</span>
            <span class="today-deal__countdown-label">Hours</span>
          </div>
          <div class="today-deal__countdown-sep">:</div>
          <div class="today-deal__countdown-item">
            <span class="today-deal__countdown-num" id="countdown-minutes">00</span>
            <span class="today-deal__countdown-label">Minutes</span>
          </div>
          <div class="today-deal__countdown-sep">:</div>
          <div class="today-deal__countdown-item">
            <span class="today-deal__countdown-num" id="countdown-seconds">00</span>
            <span class="today-deal__countdown-label">Seconds</span>
          </div>
        </div>
        <div class="today-deal__pricing">
          <span class="today-deal__original">{{ section.settings.deal_original_price }}</span>
          <span class="today-deal__sale">{{ section.settings.deal_sale_price }}</span>
        </div>
        <button class="today-btn today-btn--accent">Claim This Deal</button>
      </div>
    </div>
  </div>

  <!-- ========== CURATED PICKS ========== -->
  <div class="today-curated">
    <div class="today-curated__header">
      <span class="today-curated__label">Hand-Selected</span>
      <h2 class="today-curated__heading">Today's Curated Collection</h2>
      <p class="today-curated__subheading">Nine exquisite shapes, each chosen for their exceptional quality and character.</p>
    </div>
    <div class="today-curated__grid">
      {% assign shapes = "Round,Oval,Emerald,Cushion,Pear,Princess,Marquise,Asscher,Heart" | split: ',' %}
      {% assign carats = "1.52,1.87,2.03,1.65,1.91,1.44,1.78,2.10,1.33" | split: ',' %}
      {% assign clarities = "VS1,VVS2,VVS1,VS2,IF,VVS1,VS1,VVS2,IF" | split: ',' %}
      {% assign prices = "$18,200,$22,400,$26,800,$19,600,$28,500,$16,900,$21,300,$29,700,$15,800" | split: ',' %}
      {% for shape in shapes %}
      <div class="today-curated__card" data-shape="{{ shape | downcase }}" style="animation-delay: {{ forloop.index0 | times: 80 }}ms">
        <div class="today-curated__card-img-wrap">
          <img
            src="{{ 'diamond-' | append: shape | downcase | append: '.png' | asset_url }}"
            alt="{{ shape }} Cut Diamond"
            class="today-curated__card-img"
          >
        </div>
        <div class="today-curated__card-body">
          <h3 class="today-curated__card-title">{{ shape }} Cut</h3>
          <div class="today-curated__card-meta">
            <span>{{ carats[forloop.index0] }} ct</span>
            <span class="today-curated__card-dot"></span>
            <span>{{ clarities[forloop.index0] }}</span>
          </div>
          <div class="today-curated__card-price">{{ prices[forloop.index0] }}</div>
        </div>
        <button class="today-curated__card-btn">Quick View</button>
      </div>
      {% endfor %}
    </div>
  </div>

  <!-- ========== EXPERT'S PICK ========== -->
  <div class="today-expert">
    <div class="today-expert__inner">
      <div class="today-expert__diamond-wrap">
        <img
          src="{{ 'diamond-' | append: section.settings.expert_pick_shape | downcase | append: '.png' | asset_url }}"
          alt="{{ section.settings.expert_pick_shape }} Diamond"
          class="today-expert__diamond-img"
        >
      </div>
      <div class="today-expert__content">
        <span class="today-expert__badge">Expert's Pick</span>
        <blockquote class="today-expert__quote">
          &ldquo;{{ section.settings.expert_quote }}&rdquo;
        </blockquote>
        <div class="today-expert__author">
          <div class="today-expert__author-avatar">
            {{ section.settings.expert_name | slice: 0 }}
          </div>
          <div class="today-expert__author-info">
            <strong>{{ section.settings.expert_name }}</strong>
            <span>{{ section.settings.expert_title }}</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ========== SHAPE EXPLORER ========== -->
  <div class="today-explorer">
    <div class="today-explorer__header">
      <h2 class="today-explorer__heading">Explore by Shape</h2>
      <p class="today-explorer__subheading">Discover the personality behind every cut.</p>
    </div>
    <div class="today-explorer__shapes">
      {% assign explorer_shapes = "Round,Oval,Emerald,Cushion,Pear,Princess,Marquise,Asscher,Heart" | split: ',' %}
      {% for shape in explorer_shapes %}
      <button class="today-explorer__shape-btn{% if forloop.first %} today-explorer__shape-btn--active{% endif %}" data-explorer-shape="{{ shape | downcase }}">
        <img
          src="{{ 'diamond-' | append: shape | downcase | append: '.png' | asset_url }}"
          alt="{{ shape }}"
          class="today-explorer__shape-img"
        >
        <span>{{ shape }}</span>
      </button>
      {% endfor %}
    </div>
    <div class="today-explorer__detail" id="explorer-detail">
      <div class="today-explorer__detail-inner">
        <h3 class="today-explorer__detail-title" id="explorer-title">Round Brilliant</h3>
        <p class="today-explorer__detail-text" id="explorer-text">
          The round brilliant is the most popular and researched diamond shape. With 58 facets optimized through over a century of mathematical analysis, it delivers unparalleled brilliance and fire. Its symmetrical form makes it the benchmark against which all other shapes are measured.
        </p>
        <div class="today-explorer__detail-traits" id="explorer-traits">
          <div class="today-explorer__trait">
            <span class="today-explorer__trait-label">Brilliance</span>
            <div class="today-explorer__trait-bar"><div class="today-explorer__trait-fill" style="width:98%"></div></div>
          </div>
          <div class="today-explorer__trait">
            <span class="today-explorer__trait-label">Fire</span>
            <div class="today-explorer__trait-bar"><div class="today-explorer__trait-fill" style="width:95%"></div></div>
          </div>
          <div class="today-explorer__trait">
            <span class="today-explorer__trait-label">Scintillation</span>
            <div class="today-explorer__trait-bar"><div class="today-explorer__trait-fill" style="width:97%"></div></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ========== FOOTER CTA ========== -->
  <div class="today-cta">
    <h2 class="today-cta__heading">Find Your Perfect Stone</h2>
    <p class="today-cta__text">Every Stienhardt diamond is ethically sourced, GIA certified, and hand-selected by our expert gemologists.</p>
    <div class="today-cta__buttons">
      <button class="today-btn today-btn--primary today-btn--lg">Browse All Diamonds</button>
      <button class="today-btn today-btn--outline today-btn--lg">Book a Consultation</button>
    </div>
  </div>
</section>

<!-- ========== STYLES ========== -->
<style>
  /* === Reset & Base === */
  .today-section {
    --t-primary: #1a1a2e;
    --t-accent: #c9a84c;
    --t-accent-dark: #b08d3a;
    --t-bg: #fafaf8;
    --t-bg-dark: #1a1a2e;
    --t-bg-warm: #f5f0e8;
    --t-text: #2d2d3a;
    --t-text-light: #6b6b7b;
    --t-text-inverse: #f5f0e8;
    --t-border: #e8e4dc;
    --t-radius: 12px;
    --t-radius-lg: 20px;
    --t-shadow: 0 4px 24px rgba(26, 26, 46, 0.08);
    --t-shadow-lg: 0 12px 48px rgba(26, 26, 46, 0.12);
    --t-transition: 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);

    font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, sans-serif;
    color: var(--t-text);
    line-height: 1.6;
    overflow-x: hidden;
  }

  .today-section *, .today-section *::before, .today-section *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  /* === Buttons === */
  .today-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 32px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: all var(--t-transition);
    font-family: inherit;
  }

  .today-btn--primary {
    background: var(--t-primary);
    color: var(--t-text-inverse);
  }
  .today-btn--primary:hover {
    background: #2a2a4e;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(26, 26, 46, 0.25);
  }

  .today-btn--accent {
    background: var(--t-accent);
    color: var(--t-primary);
  }
  .today-btn--accent:hover {
    background: var(--t-accent-dark);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(201, 168, 76, 0.35);
  }

  .today-btn--outline {
    background: transparent;
    color: var(--t-primary);
    border: 2px solid var(--t-primary);
  }
  .today-btn--outline:hover {
    background: var(--t-primary);
    color: var(--t-text-inverse);
    transform: translateY(-2px);
  }

  .today-btn--lg {
    padding: 18px 42px;
    font-size: 15px;
  }

  /* === Hero === */
  .today-hero {
    position: relative;
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 40%, #0f3460 100%);
    overflow: hidden;
  }

  .today-hero::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(ellipse at 30% 50%, rgba(201, 168, 76, 0.08) 0%, transparent 60%),
                radial-gradient(ellipse at 70% 30%, rgba(201, 168, 76, 0.05) 0%, transparent 50%);
    animation: heroShimmer 12s ease-in-out infinite alternate;
  }

  @keyframes heroShimmer {
    0% { transform: translate(0, 0) rotate(0deg); }
    100% { transform: translate(2%, -2%) rotate(1deg); }
  }

  .today-hero__overlay {
    position: absolute;
    inset: 0;
    background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23c9a84c' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    opacity: 0.5;
  }

  .today-hero__content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 60px 24px;
    max-width: 700px;
    animation: heroFadeIn 1s ease-out;
  }

  @keyframes heroFadeIn {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .today-hero__date {
    display: inline-block;
    padding: 6px 20px;
    background: rgba(201, 168, 76, 0.15);
    border: 1px solid rgba(201, 168, 76, 0.3);
    border-radius: 50px;
    color: var(--t-accent);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 28px;
  }

  .today-hero__heading {
    font-size: clamp(36px, 6vw, 64px);
    font-weight: 300;
    color: #fff;
    letter-spacing: -0.01em;
    line-height: 1.15;
    margin-bottom: 20px;
  }

  .today-hero__subheading {
    font-size: clamp(16px, 2vw, 19px);
    color: rgba(255, 255, 255, 0.6);
    font-weight: 300;
    line-height: 1.7;
    max-width: 520px;
    margin: 0 auto 40px;
  }

  .today-hero__scroll-hint {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: rgba(201, 168, 76, 0.6);
    font-size: 12px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    animation: scrollBounce 2s ease-in-out infinite;
  }

  @keyframes scrollBounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(8px); }
  }

  /* === Featured Diamond === */
  .today-featured {
    position: relative;
    max-width: 1100px;
    margin: -60px auto 0;
    padding: 0 24px;
    z-index: 3;
  }

  .today-featured__badge {
    display: inline-block;
    padding: 8px 20px;
    background: var(--t-accent);
    color: var(--t-primary);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    border-radius: 6px 6px 0 0;
    margin-left: 40px;
  }

  .today-featured__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    background: #fff;
    border-radius: 0 var(--t-radius-lg) var(--t-radius-lg) var(--t-radius-lg);
    box-shadow: var(--t-shadow-lg);
    overflow: hidden;
  }

  .today-featured__visual {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 60px;
    background: linear-gradient(145deg, #f8f6f0, #f0ece2);
    position: relative;
  }

  .today-featured__img-wrap {
    position: relative;
    width: 220px;
    height: 220px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .today-featured__img {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 8px 24px rgba(0,0,0,0.1));
    transition: transform var(--t-transition);
    animation: featuredFloat 4s ease-in-out infinite;
  }

  @keyframes featuredFloat {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-10px) rotate(1deg); }
  }

  .today-featured__glow {
    position: absolute;
    inset: -20%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(201, 168, 76, 0.15) 0%, transparent 70%);
    animation: glowPulse 3s ease-in-out infinite;
  }

  @keyframes glowPulse {
    0%, 100% { opacity: 0.5; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.05); }
  }

  .today-featured__details {
    padding: 50px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .today-featured__label {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--t-accent-dark);
    margin-bottom: 12px;
  }

  .today-featured__title {
    font-size: 32px;
    font-weight: 300;
    color: var(--t-primary);
    letter-spacing: -0.01em;
    margin-bottom: 16px;
  }

  .today-featured__desc {
    font-size: 15px;
    color: var(--t-text-light);
    line-height: 1.8;
    margin-bottom: 28px;
  }

  .today-featured__specs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 28px;
    padding: 20px;
    background: var(--t-bg);
    border-radius: 10px;
  }

  .today-featured__spec {
    text-align: center;
  }

  .today-featured__spec-value {
    display: block;
    font-size: 18px;
    font-weight: 600;
    color: var(--t-primary);
    margin-bottom: 4px;
  }

  .today-featured__spec-label {
    font-size: 11px;
    color: var(--t-text-light);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .today-featured__price {
    font-size: 28px;
    font-weight: 300;
    color: var(--t-primary);
    margin-bottom: 24px;
  }

  /* === Daily Deal === */
  .today-deal {
    max-width: 1100px;
    margin: 80px auto;
    padding: 0 24px;
  }

  .today-deal__inner {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    background: linear-gradient(135deg, #1a1a2e, #16213e);
    border-radius: var(--t-radius-lg);
    overflow: hidden;
    box-shadow: var(--t-shadow-lg);
  }

