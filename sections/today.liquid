</style>

<!-- ========== JAVASCRIPT ========== -->
<script>
  document.addEventListener('DOMContentLoaded', function () {
    // === Today's Date ===
    var dateEl = document.getElementById('today-date');
    if (dateEl) {
      var now = new Date();
      var options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
      dateEl.textContent = now.toLocaleDateString('en-US', options);
    }

    // === Countdown Timer (end of day) ===
    function updateCountdown() {
      var now = new Date();
      var endOfDay = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 23, 59, 59);
      var diff = endOfDay - now;

      if (diff <= 0) {
        diff = 86400000; // reset to 24h
      }

      var hours = Math.floor(diff / 3600000);
      var minutes = Math.floor((diff % 3600000) / 60000);
      var seconds = Math.floor((diff % 60000) / 1000);

      var hoursEl = document.getElementById('countdown-hours');
      var minutesEl = document.getElementById('countdown-minutes');
      var secondsEl = document.getElementById('countdown-seconds');

      if (hoursEl) hoursEl.textContent = String(hours).padStart(2, '0');
      if (minutesEl) minutesEl.textContent = String(minutes).padStart(2, '0');
      if (secondsEl) secondsEl.textContent = String(seconds).padStart(2, '0');
    }

    updateCountdown();
    setInterval(updateCountdown, 1000);

    // === Shape Explorer ===
    var shapeData = {
      round: {
        title: 'Round Brilliant',
        text: 'The round brilliant is the most popular and researched diamond shape. With 58 facets optimized through over a century of mathematical analysis, it delivers unparalleled brilliance and fire. Its symmetrical form makes it the benchmark against which all other shapes are measured.',
        traits: { Brilliance: 98, Fire: 95, Scintillation: 97 }
      },
      oval: {
        title: 'Oval Cut',
        text: 'The oval cut offers a brilliant-style facet pattern in an elongated silhouette that creates the illusion of greater size. Its graceful shape flatters the hand and pairs beautifully with both solitaire and halo settings.',
        traits: { Brilliance: 90, Fire: 85, Scintillation: 88 }
      },
      emerald: {
        title: 'Emerald Cut',
        text: 'Distinguished by its step-cut facets and open table, the emerald cut offers a hall-of-mirrors effect with dramatic flashes of light. It emphasizes clarity over brilliance, making it the connoisseur\'s choice for exceptional transparency.',
        traits: { Brilliance: 72, Fire: 65, Scintillation: 70 }
      },
      cushion: {
        title: 'Cushion Cut',
        text: 'The cushion cut combines a soft, rounded square outline with brilliant-style facets for exceptional fire. With roots dating back over two centuries, it offers a romantic, vintage aesthetic that\'s experiencing a modern resurgence.',
        traits: { Brilliance: 85, Fire: 92, Scintillation: 84 }
      },
      pear: {
        title: 'Pear Shape',
        text: 'The pear shape merges the brilliance of the round with the elongated elegance of the marquise. Its teardrop silhouette creates a striking, distinctive look and offers excellent perceived size for its carat weight.',
        traits: { Brilliance: 88, Fire: 86, Scintillation: 85 }
      },
      princess: {
        title: 'Princess Cut',
        text: 'The princess cut is the most popular non-round diamond shape, featuring a contemporary square outline with brilliant-style faceting. It offers excellent brilliance and a clean, modern geometric aesthetic.',
        traits: { Brilliance: 92, Fire: 88, Scintillation: 90 }
      },
      marquise: {
        title: 'Marquise Cut',
        text: 'The marquise cut maximizes carat weight with its elongated boat-shaped outline, creating the largest face-up appearance of any diamond shape. Its dramatic points and sweeping curves evoke a sense of regal sophistication.',
        traits: { Brilliance: 85, Fire: 82, Scintillation: 83 }
      },
      asscher: {
        title: 'Asscher Cut',
        text: 'The Asscher cut is a square step-cut with cropped corners, creating an octagonal outline. Developed in 1902, its distinctive "X" pattern and deep pavilion produce mesmerizing concentric squares of light and dark.',
        traits: { Brilliance: 70, Fire: 68, Scintillation: 72 }
      },
      heart: {
        title: 'Heart Shape',
        text: 'The heart shape is the ultimate romantic symbol in diamond cutting. Requiring exceptional skill to achieve perfect symmetry, it combines the brilliance of modified brilliant facets with an unmistakable silhouette of love.',
        traits: { Brilliance: 86, Fire: 84, Scintillation: 82 }
      }
    };

    var explorerBtns = document.querySelectorAll('.today-explorer__shape-btn');
    var explorerTitle = document.getElementById('explorer-title');
    var explorerText = document.getElementById('explorer-text');
    var explorerTraits = document.getElementById('explorer-traits');

    explorerBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var shape = btn.getAttribute('data-explorer-shape');
        var data = shapeData[shape];
        if (!data) return;

        // Update active state
        explorerBtns.forEach(function (b) { b.classList.remove('today-explorer__shape-btn--active'); });
        btn.classList.add('today-explorer__shape-btn--active');

        // Update content
        if (explorerTitle) explorerTitle.textContent = data.title;
        if (explorerText) explorerText.textContent = data.text;

        // Update trait bars
        if (explorerTraits) {
          var traitsHTML = '';
          for (var trait in data.traits) {
            traitsHTML += '<div class="today-explorer__trait">' +
              '<span class="today-explorer__trait-label">' + trait + '</span>' +
              '<div class="today-explorer__trait-bar">' +
              '<div class="today-explorer__trait-fill" style="width:0%"></div>' +
              '</div></div>';
          }
          explorerTraits.innerHTML = traitsHTML;

          // Animate bars in
          requestAnimationFrame(function () {
            var fills = explorerTraits.querySelectorAll('.today-explorer__trait-fill');
            var traitKeys = Object.keys(data.traits);
            fills.forEach(function (fill, i) {
              requestAnimationFrame(function () {
                fill.style.width = data.traits[traitKeys[i]] + '%';
              });
            });
          });
        }
      });
    });

    // === Scroll-based Animations ===
    var observerOptions = { threshold: 0.1, rootMargin: '0px 0px -50px 0px' };

    var animateObserver = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('today-visible');
          animateObserver.unobserve(entry.target);
        }
      });
    }, observerOptions);

    var animateTargets = document.querySelectorAll(
      '.today-featured, .today-deal, .today-curated, .today-expert, .today-explorer, .today-cta'
    );
    animateTargets.forEach(function (target) {
      target.style.opacity = '0';
      target.style.transform = 'translateY(30px)';
      target.style.transition = 'opacity 0.8s ease-out, transform 0.8s ease-out';
      animateObserver.observe(target);
    });

    // Add the visible class styles
    var styleSheet = document.createElement('style');
    styleSheet.textContent = '.today-visible { opacity: 1 !important; transform: translateY(0) !important; }';
    document.head.appendChild(styleSheet);

    // === Curated Card Hover Parallax ===
    var cards = document.querySelectorAll('.today-curated__card');
    cards.forEach(function (card) {
      card.addEventListener('mousemove', function (e) {
        var rect = card.getBoundingClientRect();
        var x = (e.clientX - rect.left) / rect.width - 0.5;
        var y = (e.clientY - rect.top) / rect.height - 0.5;
        var img = card.querySelector('.today-curated__card-img');
        if (img) {
          img.style.transform = 'scale(1.1) translate(' + (x * 8) + 'px, ' + (y * 8) + 'px)';
        }
      });

      card.addEventListener('mouseleave', function () {
        var img = card.querySelector('.today-curated__card-img');
        if (img) {
          img.style.transform = '';
        }
      });
    });
  });
</script>
